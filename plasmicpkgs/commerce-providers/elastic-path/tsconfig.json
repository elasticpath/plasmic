{
  "extends": "../../../tsconfig.types.json",
  "include": ["./src"],
  "compilerOptions": {
    "outDir": "./api/tsc",
    // NodeNext rejects importing ESM-only better-auth from a package that also
    // publishes CommonJS (TS1479). Only declarations are emitted, so `module`
    // never reaches the output; publint and arethetypeswrong guard resolution.
    "module": "esnext",
    "moduleResolution": "bundler",
    // Iterating a Set needs an ES2015+ target (TS2802).
    "target": "ES2020",
    // eslint's no-unused-vars covers these, with a `^_` escape hatch tsc lacks.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
