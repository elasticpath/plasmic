{
  "name": "@elasticpath/plasmic-ep-commerce-elastic-path",
  "version": "0.8.0",
  "description": "Plasmic registration calls for elastic path commerce provider",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.esm.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && pnpm build:types && pnpm build:index && pnpm build:server",
    "build:types": "tsc",
    "build:index": "node ../../../build.mjs ./src/index.tsx --use-client",
    "build:server": "node ../../../build.mjs ./src/server.ts --mjs",
    "start": "tsc && (tsc --watch --preserveWatchOutput & node ../../../build.mjs ./src/index.tsx --use-client --watch & node ../../../build.mjs ./src/server.ts --mjs --watch & wait)",
    "test": "NODE_OPTIONS=--experimental-vm-modules TEST_CWD=`pwd` pnpm -w test --passWithNoTests && pnpm test:vitest",
    "test:vitest": "vitest run",
    "prepublishOnly": "npm run build && npm run verify:package",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@plasmicapp/host": "2.0.15",
    "@plasmicapp/query": "0.1.87",
    "@types/debounce": "^1.2.4",
    "@types/js-cookie": "^3.0.1",
    "@types/node": "^14.0.26",
    "publint": "0.3.24",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependencies": {
    "@plasmicapp/host": ">=1.0.0",
    "@plasmicapp/query": ">=0.1.0",
    "next": ">=14.0.0",
    "react": ">=16.8.0",
    "react-hook-form": ">=7.28.0",
    "swr": ">=1.0.0"
  },
  "dependencies": {
    "@algolia/autocomplete-core": "^1.17.7",
    "@elasticpath/catalog-search-instantsearch-adapter": "0.1.0",
    "@epcc-sdk/sdks-shopper": "^0.1.0",
    "@hookform/resolvers": "^3.3.2",
    "@stripe/react-stripe-js": "^2.4.0",
    "@stripe/stripe-js": "^2.4.0",
    "@types/react": "^18.0.27",
    "better-auth": "^1.6.9",
    "debounce": "^2.0.0",
    "instantsearch.js": "^4.96.0",
    "js-cookie": "^3.0.5",
    "qs": "^6.11.0",
    "react-instantsearch": "^7.32.0",
    "react-instantsearch-nextjs": "^1.4.5",
    "stripe": "^14.0.0",
    "zod": "^3.22.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  }
}
