# Dockerfile for PublishHostless task
# This layers canvas-packages on top of the deployed WAB image
# Usage: docker build --build-arg BASE_IMAGE=<deployed-wab-image> ...

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Copy pre-built canvas-packages for hostless publishing
COPY canvas-packages/build-server/ /app/canvas-packages/build-server/
COPY canvas-packages/hostlessList.json /app/canvas-packages/hostlessList.json

CMD ["node", "-r", "esbuild-register", "src/wab/server/db/PublishHostless.ts"]
