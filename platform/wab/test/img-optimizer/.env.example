W# Image Optimizer Test Environment Configuration
# Copy this file to .env and configure for your testing environment

# Image optimizer server port
IMG_OPTIMIZER_PORT=3005

# LocalStack S3 Configuration (for local testing)
S3_ENDPOINT=http://localhost:4566
SITE_ASSETS_BUCKET=test-bucket
SITE_ASSETS_BASE_URL=http://localhost:4566/test-bucket/

# AWS credentials (any values work with LocalStack)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# Production AWS S3 Configuration (uncomment to test with real AWS)
# S3_ENDPOINT=https://s3.amazonaws.com
# SITE_ASSETS_BUCKET=your-real-bucket-name
# SITE_ASSETS_BASE_URL=https://your-real-bucket.s3.amazonaws.com/
# AWS_ACCESS_KEY_ID=your-real-access-key
# AWS_SECRET_ACCESS_KEY=your-real-secret-key
# AWS_REGION=us-east-1