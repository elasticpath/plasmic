{
  "name": "@elasticpath/plasmic-mcp-registry",
  "version": "0.2.2",
  "description": "Reads all five Plasmic globalThis registries and serializes metadata for HTTP transport",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "require": "./dist/next.js",
      "import": "./dist/next.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@plasmicapp/host": ">=1.0.0"
  },
  "devDependencies": {
    "@plasmicapp/host": "2.0.15",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT"
}
