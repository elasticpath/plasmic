# =============================================================================
# Eval System Environment Variables
#
# Copy this file to .env and fill in the values for your environment.
# See cli.ts --help for CLI flag equivalents.
# =============================================================================

# ---------------------------------------------------------------------------
# Required — always needed
# ---------------------------------------------------------------------------

# Anthropic API key for Claude API calls (eval runner + LLM judge)
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Required — integration mode only (--integration flag)
# ---------------------------------------------------------------------------

# Plasmic API host URL (e.g., https://studio.plasmic.app)
PLASMIC_AUTH_HOST=https://studio.plasmic.app

# Plasmic auth credentials (user email and API token)
PLASMIC_AUTH_USER=your-email@example.com
PLASMIC_AUTH_TOKEN=your-plasmic-token

# ---------------------------------------------------------------------------
# Optional — integration mode
# ---------------------------------------------------------------------------

# Plasmic project ID for integration evals. If omitted, auto-detects via
# project.list (uses first project found). Can also use --project-id flag.
# EVAL_PROJECT_ID=your-project-id

# ---------------------------------------------------------------------------
# Optional — visual capture (integration mode + Playwright screenshots)
# If omitted, visual capture is silently skipped.
# ---------------------------------------------------------------------------

# Plasmic Studio login credentials for Playwright browser session
# PLASMIC_STUDIO_EMAIL=your-studio-email@example.com
# PLASMIC_STUDIO_PASSWORD=your-studio-password

# ---------------------------------------------------------------------------
# Optional — dashboard
# ---------------------------------------------------------------------------

# TCP port for the eval dashboard web server (npm run eval:dashboard)
# Default: 3847
# EVAL_DASHBOARD_PORT=3847
