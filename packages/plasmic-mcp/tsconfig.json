{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "lodash"],
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/__tests__", "src/__mocks__", "src/headless-renderer-entry.ts"],
  "references": []
}
