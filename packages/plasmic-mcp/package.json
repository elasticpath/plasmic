{
  "name": "@elasticpath/plasmic-mcp",
  "version": "0.1.0",
  "description": "MCP server for Plasmic Studio with embedded editing engine",
  "type": "module",
  "bin": {
    "plasmic-mcp": "./dist/index.cjs"
  },
  "main": "./dist/index.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "typecheck": "tsc --noEmit",
    "eval": "tsx evals/cli.ts",
    "eval:validate": "tsx evals/harness/scenario-validator.ts",
    "eval:dashboard": "node evals/dashboard/render.js",
    "eval:cleanup": "node evals/dashboard/render.js --cleanup-only"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@xmldom/xmldom": "^0.8.0",
    "acorn": "^8.0.0",
    "acorn-walk": "^8.0.0",
    "class-validator": "^0.14.0",
    "classnames": "^2.3.0",
    "css-initials": "^0.3.0",
    "css.escape": "^1.5.0",
    "dayjs": "^1.11.0",
    "escodegen": "^2.1.0",
    "js-string-escape": "^1.0.0",
    "lodash": "^4.17.21",
    "memoize-one": "^6.0.0",
    "mime": "^2.6.0",
    "mobx": "6.13.6",
    "mobx-utils": "^6.0.0",
    "nanoid": "^3.3.0",
    "parse-data-url": "^2.0.0",
    "regex": "^4.0.0",
    "regexp.execall": "^1.0.0",
    "semver": "^6.3.0",
    "short-uuid": "^5.0.0",
    "strip-css-comments": "^4.0.0",
    "ts-failable": "^0.6.0",
    "underscore.string": "^3.3.0",
    "url-join": "^4.0.0",
    "uuid": "^11.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0",
    "playwright": "^1.58.2",
    "tsx": "^4.20.0",
    "typescript": "^5.2.0",
    "vitest": "3.2.4",
    "yaml": "^2.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
